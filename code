# ---------------------------------------------------------------------------
# Structured extraction
# ---------------------------------------------------------------------------


def extract_resume(text: str) -> dict:
    raw = text.strip()
    lines = [ln.strip() for ln in raw.splitlines() if ln.strip()]

    email_m = re.search(r"[\w.+-]+@[\w.-]+\.\w+", raw)
    email = email_m.group(0) if email_m else ""

    name = ""
    for ln in lines[:5]:
        if email and email in ln:
            continue
        if re.search(r"^(experience|education|skills|email|phone|resume)\b", ln, re.I):
            continue
        if 2 <= len(ln.split()) <= 5 and not re.search(r"@|http", ln):
            name = ln
            break
    if not name and lines:
        name = lines[0]

    skills_block = ""
    for i, ln in enumerate(lines):
        if re.match(r"^skills\b", ln, re.I):
            skills_block = ln.split(":", 1)[-1] + " " + " ".join(lines[i + 1 : i + 3])
            break
    hay = (skills_block or raw).lower()
    skills: list[str] = []
    seen = set()
    for skill in SKILL_VOCAB:
        if re.search(rf"(?<![a-z]){re.escape(skill)}(?![a-z])", hay):
            if skill not in seen:
                seen.add(skill)
                skills.append(skill)

    education = ""
    for i, ln in enumerate(lines):
        if re.match(r"^education\b", ln, re.I):
            education = ln.split(":", 1)[-1].strip()
            if not education and i + 1 < len(lines):
                education = lines[i + 1]
            break
    if not education:
        for ln in lines:
            if re.search(r"\b(b\.?s\.?|m\.?s\.?|bachelor|master|ph\.?d|bootcamp)\b", ln, re.I):
                education = ln
                break

    titles: list[str] = []
    for ln in lines:
        if re.search(r"\b(engineer|developer|analyst|scientist|manager|designer|sre|intern)\b", ln, re.I):
            if re.match(r"^skills\b", ln, re.I):
                continue
            if len(ln) < 90:
                titles.append(re.sub(r"\s{2,}", " ", ln)[:90])
    titles = titles[:6]

    years = years_from_text(raw)

    profile = {
        "name": name or "Unknown",
        "email": email,
        "skills": skills,
        "years_experience": years,
        "education": education,
        "titles": titles,
        "raw_length": len(raw),
        "embedding_text": " ".join(
            [name, education, " ".join(skills), " ".join(titles), raw[:800]]
        ),
    }
    return profile


def job_embedding_text(job: dict) -> str:
    return " ".join(
        [
            job["title"],
            job["category"],
            job["description"],
            " ".join(job["skills"]),
            f"{job.get('min_years', 0)} years",
        ]
    )


# ---------------------------------------------------------------------------
# Matching via similarity (no manual weighted rules)
# ---------------------------------------------------------------------------


def match_score(profile: dict, job: dict) -> dict:
    """
    Rank signal is cosine similarity between resume and job embeddings.
    Skill overlap and experience gap are reported as *explanations*, not as
    hand-tuned components of a composite rule score.
    """
    p_vec = embed(profile.get("embedding_text") or "")
    j_vec = embed(job_embedding_text(job))
    similarity = max(0.0, cosine(p_vec, j_vec))

    cand_skills = {s.lower() for s in profile.get("skills") or []}
    job_skills = {s.lower() for s in job.get("skills") or []}
    overlap = sorted(cand_skills & job_skills)
    missing = sorted(job_skills - cand_skills)
    skill_j = jaccard(cand_skills, job_skills)

    years = float(profile.get("years_experience") or 0)
    min_y = float(job.get("min_years") or 0)
    exp_gap = years - min_y

    # Primary rank key = similarity only (constraint: no manual scoring rules)
    rank_score = round(similarity * 100, 2)

    return {
        "rank_score": rank_score,
        "similarity": round(similarity, 4),
        "skill_jaccard": round(skill_j, 4),
        "overlapping_skills": overlap,
        "missing_skills": missing,
        "years_experience": years,
        "job_min_years": min_y,
        "experience_gap_years": round(exp_gap, 1),
    }


def explain_match(profile: dict, job: dict, score: dict) -> str:
    name = profile.get("name") or "Candidate"
    parts = [
        f"{name} ranks at {score['rank_score']} similarity for {job['title']}.",
        f"Shared skills: {', '.join(score['overlapping_skills']) or 'none'}.",
    ]
    if score["missing_skills"]:
        parts.append("Not listed on resume: " + ", ".join(score["missing_skills"][:6]) + ".")
    if score["experience_gap_years"] < 0:
        parts.append(
            f"Reported experience is {abs(score['experience_gap_years'])} years below the posted minimum."
        )
    elif score["experience_gap_years"] >= 0:
        parts.append(
            f"Reported experience meets or exceeds the {score['job_min_years']}-year baseline."
        )
    return strip_machine_labels(" ".join(parts))


def recruiter_summary(profile: dict, job: dict, score: dict, rank: int) -> str:
    text = (
        f"#{rank} {profile.get('name', 'Candidate')} — {job['title']} "
        f"(score {score['rank_score']}). "
        f"{profile.get('years_experience', 0)} years experience. "
        f"Skills overlap: {', '.join(score['overlapping_skills'][:5]) or 'limited'}. "
        f"{explain_match(profile, job, score)}"
    )
    return strip_machine_labels(text)


# ---------------------------------------------------------------------------
# Evaluation metrics
# ---------------------------------------------------------------------------


def extraction_metrics(predicted: dict, gold: dict) -> dict:
    """Field-level quality for structured extraction."""
    name_ok = predicted.get("name", "").lower() == gold.get("name", "").lower()
    email_ok = predicted.get("email", "").lower() == gold.get("email", "").lower()

    pred_skills = {s.lower() for s in predicted.get("skills") or []}
    gold_skills = {s.lower() for s in gold.get("skills") or []}
    if gold_skills:
        skill_precision = len(pred_skills & gold_skills) / max(1, len(pred_skills))
        skill_recall = len(pred_skills & gold_skills) / len(gold_skills)
        skill_f1 = (
            2 * skill_precision * skill_recall / (skill_precision + skill_recall)
            if (skill_precision + skill_recall)
            else 0.0
        )
    else:
        skill_precision = skill_recall = skill_f1 = 0.0

    years_err = abs(float(predicted.get("years_experience") or 0) - float(gold.get("years_experience") or 0))
    edu_hit = 1.0 if (gold.get("education") or "").lower()[:20] in (predicted.get("education") or "").lower() else 0.0

    return {
        "name_accuracy": 1.0 if name_ok else 0.0,
        "email_accuracy": 1.0 if email_ok else 0.0,
        "skill_precision": round(skill_precision, 3),
        "skill_recall": round(skill_recall, 3),
        "skill_f1": round(skill_f1, 3),
        "years_abs_error": round(years_err, 2),
        "education_hit": edu_hit,
    }


def ranking_metrics(ranked_ids: list[str], gold_best_id: str) -> dict:
    """Matching quality: is the gold-best candidate at top / in top-3?"""
    if not ranked_ids:
        return {"top1_hit": 0.0, "top3_hit": 0.0, "reciprocal_rank": 0.0}
    top1 = 1.0 if ranked_ids[0] == gold_best_id else 0.0
    top3 = 1.0 if gold_best_id in ranked_ids[:3] else 0.0
    rr = 0.0
    for i, cid in enumerate(ranked_ids, 1):
        if cid == gold_best_id:
            rr = 1.0 / i
            break
    return {"top1_hit": top1, "top3_hit": top3, "reciprocal_rank": round(rr, 3)}


def run_evaluation() -> dict:
    """Aggregate extraction + matching metrics over the labeled sample set."""
    extract_scores = []
    profiles = []
    for sample in SAMPLE_RESUMES:
        pred = extract_resume(sample["text"])
        pred["id"] = sample["id"]
        profiles.append(pred)
        extract_scores.append(extraction_metrics(pred, sample["gold"]))

    def mean(key: str) -> float:
        return round(sum(s[key] for s in extract_scores) / len(extract_scores), 3)

    extraction = {
        "n": len(extract_scores),
        "name_accuracy": mean("name_accuracy"),
        "email_accuracy": mean("email_accuracy"),
        "skill_precision": mean("skill_precision"),
        "skill_recall": mean("skill_recall"),
        "skill_f1": mean("skill_f1"),
        "years_mae": mean("years_abs_error"),
        "education_hit": mean("education_hit"),
    }

    # For each job that has gold ranks, measure whether gold #1 is top of our ranking
    match_scores = []
    for job_id, job in JOBS.items():
        gold_first = None
        for sample in SAMPLE_RESUMES:
            gr = sample.get("gold_rank") or {}
            if gr.get(job_id) == 1:
                gold_first = sample["id"]
                break
        if not gold_first:
            continue
        ranked = sorted(
            (
                (p["id"], match_score(p, job)["rank_score"])
                for p in profiles
            ),
            key=lambda x: x[1],
            reverse=True,
        )
        ranked_ids = [r[0] for r in ranked]
        m = ranking_metrics(ranked_ids, gold_first)
        m["job_id"] = job_id
        match_scores.append(m)

    matching = {
        "n_jobs": len(match_scores),
        "top1_accuracy": round(sum(m["top1_hit"] for m in match_scores) / max(1, len(match_scores)), 3),
        "top3_accuracy": round(sum(m["top3_hit"] for m in match_scores) / max(1, len(match_scores)), 3),
        "mean_reciprocal_rank": round(
            sum(m["reciprocal_rank"] for m in match_scores) / max(1, len(match_scores)), 3
        ),
        "per_job": match_scores,
    }
    return {"extraction": extraction, "matching": matching}


