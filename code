)

# ---------------------------------------------------------------------------
# Text / embedding helpers (similarity-based ranking — no manual weights)
# ---------------------------------------------------------------------------


def tokens(text: str, drop_stop: bool = True) -> list[str]:
    parts = re.sub(r"[^a-z0-9.+#]+", " ", text.lower()).split()
    parts = [t for t in parts if len(t) > 1]
    if drop_stop:
        parts = [t for t in parts if t not in STOP]
    return parts


def fnv(s: str) -> int:
    h = 2166136261
    for ch in s:
        h ^= ord(ch)
        h = (h * 16777619) & 0xFFFFFFFF
    return h


def embed(text: str) -> list[float]:
    """Feature-hashed bag-of-tokens embedding for cosine matching."""
    v = [0.0] * EMBED_DIM
    for t in tokens(text, drop_stop=False):
        h = fnv(t)
        v[h % EMBED_DIM] += 1.0 if (h & 0x100) else -1.0
        if len(t) > 3:
            for i in range(len(t) - 2):
                tri = "#" + t[i : i + 3]
                h2 = fnv(tri)
                v[h2 % EMBED_DIM] += 0.4 * (1.0 if (h2 & 0x100) else -1.0)
    n = math.sqrt(sum(x * x for x in v)) or 1.0
    return [x / n for x in v]


def cosine(a: list[float], b: list[float]) -> float:
    return sum(x * y for x, y in zip(a, b))


def jaccard(a: set[str], b: set[str]) -> float:
    if not a and not b:
        return 0.0
    return len(a & b) / len(a | b)


def strip_machine_labels(text: str) -> str:
    cleaned = re.sub(
        r"(?i)\s*[\(\[]?\s*(ai[- ]generated|generated by (ai|an? (ai|llm|model))|"
        r"as an ai[\w\s]*|powered by ai|created with (ai|chatgpt)|"
        r"this (summary|ranking|match) was (automatically )?generated)\s*[\)\]]?\s*",
        " ",
        text,
    )
    return re.sub(r"\s{2,}", " ", cleaned).strip()


def years_from_text(text: str) -> float:
    years = 0.0
    for m in re.finditer(
        r"(20\d{2}|19\d{2})\s*[-–—to]+\s*(20\d{2}|19\d{2}|present|current|now)",
        text,
        re.I,
    ):
        start = int(m.group(1))
        end_raw = m.group(2).lower()
        end = 2026 if end_raw in ("present", "current", "now") else int(end_raw)
        if end >= start:
            years += end - start
    for m in re.finditer(r"(\d+(?:\.\d+)?)\+?\s*years?", text, re.I):
        years = max(years, float(m.group(1)))
    return round(min(years, 40.0), 1)


