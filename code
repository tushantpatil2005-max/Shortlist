def main():
    parser = argparse.ArgumentParser(description="AI Resume & Job Matching Platform")
    parser.add_argument("--check", action="store_true")
    parser.add_argument("--evaluate", action="store_true")
    parser.add_argument("--job", default="backend_engineer")
    parser.add_argument("--rank-samples", action="store_true")
    parser.add_argument("--resume-file", type=str)
    parser.add_argument("--serve", action="store_true")
    parser.add_argument("--host", default="0.0.0.0")
    parser.add_argument("--port", type=int, default=8000)
    args = parser.parse_args()

    if args.check:
        notes = self_check()
        print("PASS")
        for n in notes:
            print(n)
        return

    platform = MatchPlatform()

    if args.evaluate:
        print(json.dumps(platform.evaluate(), indent=2))
        return

    if args.serve:
        if not HAS_FASTAPI:
            raise SystemExit("Install fastapi uvicorn: pip install fastapi uvicorn")
        import uvicorn

        uvicorn.run(app, host=args.host, port=args.port)
        return

    if args.rank_samples:
        resumes = [{"id": s["id"], "text": s["text"]} for s in SAMPLE_RESUMES]
        print(json.dumps(platform.rank(resumes, args.job), indent=2))
        return

    if args.resume_file:
        with open(args.resume_file, encoding="utf-8") as f:
            text = f.read()
        print(json.dumps(platform.match_one(text, args.job), indent=2))
        return

    # Default demo
    print(json.dumps(platform.match_one(SAMPLE_RESUMES[0]["text"], args.job), indent=2))


if __name__ == "__main__":
    main()
