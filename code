# Platform
# ---------------------------------------------------------------------------


class MatchPlatform:
    def __init__(self):
        self.jobs = {k: dict(v) for k, v in JOBS.items()}
        self.runs: dict[str, dict] = {}

    def list_jobs(self, category: Optional[str] = None) -> list[dict]:
        out = []
        for j in self.jobs.values():
            if category and j["category"] != category:
                continue
            out.append(
                {
                    "id": j["id"],
                    "title": j["title"],
                    "category": j["category"],
                    "location": j["location"],
                    "min_years": j["min_years"],
                }
            )
        return out

    def categories(self) -> list[str]:
        return sorted({j["category"] for j in self.jobs.values()})

    def extract(self, resume_text: str) -> dict:
        profile = extract_resume(resume_text)
        return {
            "id": f"ext_{uuid.uuid4().hex[:8]}",
            "profile": profile,
            "structured": profile,  # explicit structured output
        }

    def match_one(self, resume_text: str, job_id: str) -> dict:
        t0 = time.time()
        job = self.jobs.get(job_id)
        if not job:
            return {"status": "error", "error": f"Unknown job_id: {job_id}"}
        profile = extract_resume(resume_text)
        score = match_score(profile, job)
        explanation = explain_match(profile, job, score)
        summary = recruiter_summary(profile, job, score, rank=1)
        result = {
            "id": f"match_{uuid.uuid4().hex[:8]}",
            "status": "complete",
            "candidate": {
                "name": profile["name"],
                "email": profile["email"],
                "skills": profile["skills"],
                "years_experience": profile["years_experience"],
                "education": profile["education"],
                "titles": profile["titles"],
            },
            "job": {
                "id": job["id"],
                "title": job["title"],
                "category": job["category"],
                "location": job["location"],
            },
            "scores": {
                "rank_score": score["rank_score"],
                "similarity": score["similarity"],
                "skill_jaccard": score["skill_jaccard"],
            },
            "overlapping_skills": score["overlapping_skills"],
            "missing_skills": score["missing_skills"],
            "explanation": explanation,
            "recruiter_summary": summary,
            "timings_ms": round((time.time() - t0) * 1000, 2),
        }
        self.runs[result["id"]] = result
        return result

    def rank(
        self,
        resumes: list[dict],
        job_id: str,
        limit: int = 10,
    ) -> dict:
        """
        Batch rank. Each item in resumes: {"id": optional, "text": resume_text}
        """
        t0 = time.time()
        job = self.jobs.get(job_id)
        if not job:
            return {"status": "error", "error": f"Unknown job_id: {job_id}"}

        ranked = []
        for i, item in enumerate(resumes):
            text = item.get("text") or item.get("resume_text") or ""
            cid = item.get("id") or f"cand_{i}"
            profile = extract_resume(text)
            profile["id"] = cid
            score = match_score(profile, job)
            ranked.append(
                {
                    "candidate_id": cid,
                    "candidate": {
                        "name": profile["name"],
                        "email": profile["email"],
                        "skills": profile["skills"],
                        "years_experience": profile["years_experience"],
                        "education": profile["education"],
                    },
                    "scores": {
                        "rank_score": score["rank_score"],
                        "similarity": score["similarity"],
                        "skill_jaccard": score["skill_jaccard"],
                    },
                    "overlapping_skills": score["overlapping_skills"],
                    "missing_skills": score["missing_skills"],
                    "explanation": explain_match(profile, job, score),
                }
            )

        ranked.sort(key=lambda r: r["scores"]["rank_score"], reverse=True)
        ranked = ranked[:limit]
        for i, row in enumerate(ranked, 1):
            row["rank"] = i
            row["recruiter_summary"] = recruiter_summary(
                {
                    "name": row["candidate"]["name"],
                    "years_experience": row["candidate"]["years_experience"],
                },
                job,
                {
                    "rank_score": row["scores"]["rank_score"],
                    "overlapping_skills": row["overlapping_skills"],
                    "missing_skills": row["missing_skills"],
                    "experience_gap_years": row["candidate"]["years_experience"] - job["min_years"],
                    "job_min_years": job["min_years"],
                },
                i,
            )

        result = {
            "id": f"rank_{uuid.uuid4().hex[:8]}",
            "status": "complete",
            "job": {"id": job["id"], "title": job["title"], "category": job["category"]},
            "count": len(ranked),
            "candidates": ranked,
            "timings_ms": round((time.time() - t0) * 1000, 2),
        }
        self.runs[result["id"]] = result
        return result

    def batch_match(
        self,
        items: list[dict],
    ) -> dict:
        """
        Batch processing: list of {resume_text|text, job_id, id?}.
        Returns structured results for each pair.
        """
        t0 = time.time()
        results = []
        for i, item in enumerate(items):
            text = item.get("text") or item.get("resume_text") or ""
            job_id = item.get("job_id") or ""
            one = self.match_one(text, job_id)
            one["batch_index"] = i
            one["request_id"] = item.get("id")
            results.append(one)
        return {
            "id": f"batch_{uuid.uuid4().hex[:8]}",
            "status": "complete",
            "count": len(results),
            "results": results,
            "timings_ms": round((time.time() - t0) * 1000, 2),
        }

    def evaluate(self) -> dict:
        return run_evaluation()


# ---------------------------------------------------------------------------
# Self-check
# ---------------------------------------------------------------------------


def self_check() -> list[str]:
    notes: list[str] = []
    platform = MatchPlatform()

    assert len(platform.categories()) >= 3
    assert len(platform.list_jobs()) >= 4

    # Structured extraction
    sample = SAMPLE_RESUMES[0]
    extracted = platform.extract(sample["text"])
    profile = extracted["profile"]
    assert profile["name"] == "Maya Chen"
    assert "python" in profile["skills"]
    assert profile["email"].endswith("@example.com")
    notes.append(f"extract name={profile['name']} skills={len(profile['skills'])}")

    # Single match + explanation
    m = platform.match_one(sample["text"], "backend_engineer")
    assert m["status"] == "complete"
    assert "rank_score" in m["scores"]
    assert m["explanation"]
    assert m["recruiter_summary"]
    notes.append(f"maya backend score={m['scores']['rank_score']}")

    # Multiple categories: frontend vs backend for Jordan
    jordan = SAMPLE_RESUMES[1]["text"]
    jf = platform.match_one(jordan, "frontend_engineer")
    jb = platform.match_one(jordan, "backend_engineer")
    assert jf["scores"]["rank_score"] > jb["scores"]["rank_score"]
    notes.append(f"jordan fe={jf['scores']['rank_score']} be={jb['scores']['rank_score']}")

    # Batch rank
    batch_resumes = [{"id": s["id"], "text": s["text"]} for s in SAMPLE_RESUMES]
    ranked = platform.rank(batch_resumes, "data_analyst", limit=5)
    assert ranked["status"] == "complete"
    assert ranked["candidates"][0]["rank"] == 1
    assert ranked["candidates"][0]["scores"]["rank_score"] >= ranked["candidates"][-1]["scores"]["rank_score"]
    notes.append(
        "rank data_analyst: "
        + ", ".join(f"{c['candidate']['name']}={c['scores']['rank_score']}" for c in ranked["candidates"][:3])
    )

    # Batch match pairs
    batch = platform.batch_match(
        [
            {"id": "a", "text": SAMPLE_RESUMES[0]["text"], "job_id": "backend_engineer"},
            {"id": "b", "text": SAMPLE_RESUMES[3]["text"], "job_id": "devops_engineer"},
        ]
    )
    assert batch["count"] == 2
    assert all(r["status"] == "complete" for r in batch["results"])
    notes.append(f"batch={batch['count']}")

    # Evaluation metrics present
    metrics = platform.evaluate()
    assert "extraction" in metrics and "matching" in metrics
    assert metrics["extraction"]["skill_f1"] > 0.5
    assert metrics["matching"]["top1_accuracy"] >= 0.5
    notes.append(
        f"eval skill_f1={metrics['extraction']['skill_f1']} "
        f"top1={metrics['matching']['top1_accuracy']} mrr={metrics['matching']['mean_reciprocal_rank']}"
    )

    # No AI marking
    blob = json.dumps(m) + json.dumps(ranked)
    assert not re.search(r"(?i)ai[- ]generated|powered by ai|as an ai", blob)

    # Structured outputs keys
    for key in ("candidate", "job", "scores", "explanation", "recruiter_summary"):
        assert key in m

    return notes


# ---------------------------------------------------------------------------
# FastAPI
# ---------------------------------------------------------------------------

if HAS_FASTAPI:
    app = FastAPI(title="Shortlist — Resume & Job Matching", version="1.0.0")
    _platform = MatchPlatform()

    class ExtractBody(BaseModel):
        text: str = Field(..., min_length=20)

    class MatchBody(BaseModel):
        text: str = Field(..., min_length=20)
        job_id: str

    class RankItem(BaseModel):
        id: Optional[str] = None
        text: str

    class RankBody(BaseModel):
        job_id: str
        resumes: list[RankItem]
        limit: int = 10

    class BatchItem(BaseModel):
        id: Optional[str] = None
        text: str
        job_id: str

    class BatchBody(BaseModel):
        items: list[BatchItem]

    @app.get("/health")
    def health():
        return {
            "ok": True,
            "app": APP_NAME,
            "jobs": len(_platform.jobs),
            "categories": _platform.categories(),
        }

    @app.get("/jobs")
    def jobs(category: Optional[str] = None):
        return _platform.list_jobs(category)

    @app.post("/extract")
    def extract(body: ExtractBody):
        return _platform.extract(body.text)

    @app.post("/match")
    def match(body: MatchBody):
        result = _platform.match_one(body.text, body.job_id)
        if result.get("status") == "error":
            raise HTTPException(status_code=400, detail=result.get("error"))
        return result

    @app.post("/rank")
    def rank(body: RankBody):
        resumes = [item.model_dump() for item in body.resumes]
        result = _platform.rank(resumes, body.job_id, body.limit)
        if result.get("status") == "error":
            raise HTTPException(status_code=400, detail=result.get("error"))
        return result

    @app.post("/batch")
    def batch(body: BatchBody):
        items = [item.model_dump() for item in body.items]
        return _platform.batch_match(items)

    @app.get("/evaluate")
    def evaluate():
        return _platform.evaluate()


